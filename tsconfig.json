{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "ESNext",
    "sourceMap": true,
    "strict": true
  },
  "include": ["src/**/*"]
}
