{
  "name": "@aha-app/mvc",
  "version": "0.14.0",
  "description": "Simple MVC framework using React for the view and GraphQL for the models.",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && node config/build.js && tsc",
    "prepare": "yarn build",
    "test": "vitest --typecheck",
    "demo": "esbuild demo/index.tsx --bundle --serve --watch --outdir=demo/public --servedir=demo/public",
    "demo:production": "pnpm run demo --define:process.env.NODE_ENV=\\\"production\\\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aha-app/mvc.git"
  },
  "author": "Aha!",
  "license": "UNLICENSED",
  "homepage": "https://github.com/aha-app/mvc#readme",
  "dependencies": {
    "@nx-js/observer-util": "^4.2.2",
    "debug": "^4.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-render-stream": "^2.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/debug": "^4.1.12",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.19.11",
    "esbuild-plugin-d.ts": "^1.1.0",
    "happy-dom": "^17.4.7",
    "prettier": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "packageManager": "yarn@1.22.22"
}
